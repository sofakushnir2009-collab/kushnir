            }
        }
    }

    print_3d_array(threeDArray, size);

    for (int i = 0; i < size; i++) {

        for (int j = 0; j < size; j++) {

            delete[] threeDArray[i][j];
        }

        delete[] threeDArray[i];
    }

    delete[] threeDArray;

    return 0;
