import java.util.Scanner;
public class Ex1 {
    public static void main(String[] args) {
        String a = split();
        System.out.println(a);
    }
    public static String split() {
        Scanner scanner = new Scanner(System.in);
        String input;
        boolean correct;
        do {
            System.out.print("Введіть строку: ");
            input = scanner.nextLine().trim();
            correct = true;
            String[] words = input.split("\\s+");
            if (words.length < 2) {
                correct = false;
            } else {
                for (String word : words) {
                    if (word.length() < 3) {
                        correct = false;
                        break;
                    }
                }
            }
            if (!correct) {
                System.out.println("Помилка! Мінімум 2 слова, кожне мінімум складається з 3 символів");
            }
        } while (!correct);
        return input;
    }
}
