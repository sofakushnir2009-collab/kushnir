#include <iostream>
#include <string>
#include <vector>
#include <stdexcept>

struct Vector {
    int* arr = nullptr;
    size_t count = 0;
    size_t maxCount = 0;

    size_t get_quantity() {
        return count;
    }

    size_t get_quantity_buffer() {
        return maxCount;
    }

    int& get_index(size_t pos) {
        if (pos >= count) {
            throw std::out_of_range("Array out of bounds!");
        }
        return arr[pos];
    }

    int& at(size_t pos) {
        return get_index(pos);
    }

    void delete_index(size_t pos) {
        if (pos >= count) {
            throw std::out_of_range("Array out of bounds!");
        }
        for (size_t i = pos; i < count - 1; i++) {
            arr[i] = arr[i + 1];
        }
        count--;
    }

    void add_index(size_t pos, int number) {
        if (pos > count) {
            throw std::out_of_range("Array out of bounds!");
        }
        if (count == maxCount) {
            maxCount = (maxCount == 0) ? 1 : maxCount * 2;
            int* temp = new int[maxCount];
            for (size_t i = 0; i < count; i++) {
                temp[i] = arr[i];
            }
            delete[] arr;
            arr = temp;
        }
        for (size_t i = count; i > pos; i--) {
            arr[i] = arr[i - 1];
        }
        arr[pos] = number;
        count++;
    }

    void add_element_end(int number) {
        if (count == maxCount) {
            maxCount = (maxCount == 0) ? 1 : maxCount * 2;
            int* temp = new int[maxCount];
            for (size_t i = 0; i < count; i++) {
                temp[i] = arr[i];
            }
            delete[] arr;
            arr = temp;
        }
        arr[count++] = number;
    }
};

void menu(Vector& container) {
    int choice = -1;
    while (choice != 0) {
        std::cout
        << "\n__MENUSHKA__"
        << "\n 1 - Adding elements to the end"
        << "\n 2 - Adding elements by index"
        << "\n 3 - Removing elements by index"
        << "\n 4 - Getting element by index"
        << "\n 5 - Getting number of elements present"
        << "\n 6 - Getting number of elements in buffer"
        << "\n 0 - Exit"
        << "\n> ";

        std::cin >> choice;

        switch (choice) {
            case 1: {
                int number;
                std::cout << "Value: ";
                std::cin >> number;
                container.add_element_end(number);
                break;
            }
            case 2: {
                size_t pos;
                int number;
                std::cout << "Index and Value: ";
                std::cin >> pos >> number;
                try {
                    container.add_index(pos, number);
                } catch(const std::exception& err) {
                    std::cerr << err.what() << '\n';
                }
                break;
            }
            case 3: {
                size_t pos;
                std::cout << "Index: ";
                std::cin >> pos;
                try {
                    container.delete_index(pos);
                } catch(const std::exception& err) {
                    std::cerr << err.what() << '\n';
                }
                break;
            }
            case 4: {
                size_t pos;
                std::cout << "Index: ";
                std::cin >> pos;
                try {
                    std::cout << "Element: " << container.get_index(pos) << '\n';
                } catch(const std::exception& err) {
                    std::cerr << err.what() << '\n';
                }
                break;
            }
            case 5: {
                std::cout << "Quantity: " << container.get_quantity() << '\n';
                break;
            }
            case 6: {
                std::cout << "Buffer: " << container.get_quantity_buffer() << '\n';
                break;
            }
            case 0:
                break;
            default:
                std::cerr << "Error\n";
        }
    }
}

int main() {
    Vector numbers;

    menu(numbers);

    std::cout << "\nElement of vector: ";
    for (size_t i = 0; i < numbers.count; ++i) {
        std::cout << numbers.at(i) << " ";
    }

    std::cout << "\nSize: " << numbers.count
              << "\nCapacity: " << numbers.maxCount << std::endl;

    return 0;
}
