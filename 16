#include <iostream>
#include <ctime>

using namespace std;

void print_3d_array(float*** array, int size) {

    for (int i = 0; i < size; i++) {

        for (int j = 0; j < size; j++) {

            for (int z = 0; z < size; z++) {

                cout << array[i][j][z] << " ";
            }

            cout << endl;
        }

        cout << endl;
    }
}

