bool is_point_equal(float* arr, float x, float y) {

    if (arr[0] == x && arr[1] == y) {
        return true;
    }

    return false;
}

float rectangle_area(float* arr[], int size) {

    float side1 = sqrt(
        pow(arr[1][0] - arr[0][0], 2) +
        pow(arr[1][1] - arr[0][1], 2)
    );

    float side2 = sqrt(
        pow(arr[2][0] - arr[1][0], 2) +
        pow(arr[2][1] - arr[1][1], 2)
    );

    return side1 * side2;
}

void show_menu(int& choice) {

    std::cout << "___MENU___" << std::endl;

    std::cout << "Choose option:\n"
              << "1 - Random coordinates\n"
              << "2 - Manual coordinates\n";

    std::string input;

    while (true) {

        std::cin >> input;

        try {

            size_t pos;

            choice = std::stoi(input, &pos);

            if (pos != input.length()) {
                throw std::invalid_argument("Extra character");
            }

            break;
        }

        catch (...) {
            std::cout << "Error! Try again: ";
        }
    }

    switch (choice) {
        case 1:
            fill_random_points();
            break;

        case 2:
            user_input_points();
            break;

        default:
            std::cout << "Error!";
    }
}

